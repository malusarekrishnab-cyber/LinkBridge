<Window x:Class="LinkBridge.Windows.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="LinkBridge: One Bridge. All Your Devices." Height="600" Width="800"
        Background="#1E1E1E">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="LINKBRIDGE" FontSize="36" FontWeight="Bold" Foreground="#00BCD4" HorizontalAlignment="Center"/>
            <TextBlock Text="Searching for devices..." FontSize="18" Foreground="LightGray" HorizontalAlignment="Center" Margin="0,20,0,0" x:Name="StatusText"/>
            
            <Image x:Name="QrCodeImage" Width="200" Height="200" Margin="0,20,0,0" Visibility="Collapsed" />
            
            <Button Content="Show QR Code for Pairing" Width="200" Height="40" Margin="0,30,0,0" Background="#00BCD4" Foreground="White" BorderThickness="0" Click="PairButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
